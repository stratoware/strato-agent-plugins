{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mapping_revision": {
      "type": "integer",
      "minimum": 1
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "strato": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/]+/?$"
        },
        "product_slug": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["tenant_origin", "product_slug"]
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "run_attempt": {
          "type": "integer",
          "minimum": 1
        },
        "job": {
          "type": "string",
          "minLength": 1
        },
        "matrix": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["run_id", "run_attempt", "job", "matrix"]
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["complete", "partial", "unavailable"]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": ["status", "notes"]
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "test_case_id": {
            "type": "string",
            "pattern": "^TC[0-9]+$"
          },
          "test_case_revision": {
            "type": "integer",
            "minimum": 1
          },
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "framework": {
            "type": "string",
            "minLength": 1
          },
          "suite_selector": {
            "type": "string",
            "minLength": 1
          },
          "test_selector": {
            "type": "string",
            "minLength": 1
          },
          "execution_id": {
            "type": "string",
            "minLength": 1
          },
          "parameters": {
            "type": "object",
            "additionalProperties": true
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "native_outcome": {
            "type": ["string", "null"]
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "errored",
              "skipped",
              "not_run",
              "unknown"
            ]
          },
          "duration_ms": {
            "type": ["number", "null"],
            "minimum": 0
          },
          "diagnostic_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "test_case_id",
          "test_case_revision",
          "step_id",
          "framework",
          "suite_selector",
          "test_selector",
          "execution_id",
          "parameters",
          "attempt",
          "native_outcome",
          "outcome",
          "duration_ms",
          "diagnostic_refs"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "outcome": {
                  "enum": ["passed", "failed", "errored", "skipped"]
                }
              }
            },
            "then": {
              "properties": {
                "native_outcome": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "mapping_revision",
    "mapping_sha256",
    "strato",
    "repository",
    "commit_sha",
    "workflow",
    "collection",
    "results"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strato GitHub verification results",
  "description": "Per-job test observations, not a Strato Test Run verdict or lifecycle approval."
}
